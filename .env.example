# ---------------------------------------------------------------------------
# Copie este arquivo para ".env" e ajuste se precisar:
#     Windows:  copy .env.example .env
#     Linux:    cp .env.example .env
#
# O arquivo .env NAO vai para o Git (esta no .gitignore).
# Este .env.example VAI, para que outra pessoa saiba quais variaveis existem.
# ---------------------------------------------------------------------------

# Banco de dados. Deixe vazio/comentado para usar o SQLite padrao em data/app.db
# Para migrar para PostgreSQL, basta trocar esta linha:
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/helpdesk
DATABASE_URL=

# Limite de temperatura que dispara alerta critico (Exercicio 3).
# Esta fora do codigo justamente para poder ser mudado sem recompilar nada.
TEMPERATURE_ALERT_THRESHOLD=80.0

# Zona de atencao: entre (limite - margem) e o limite, o equipamento
# aparece como AVISO na deteccao de anomalias, sem gerar alerta.
TEMPERATURE_WARNING_MARGIN=10.0

# Horas sem leitura para considerar um equipamento sem comunicacao.
STALE_READING_HOURS=24

# Mostrar no terminal todo SQL que o SQLAlchemy executa. Otimo para a
# apresentacao: prova que existe SQL de verdade por tras do ORM.
SQL_ECHO=false
